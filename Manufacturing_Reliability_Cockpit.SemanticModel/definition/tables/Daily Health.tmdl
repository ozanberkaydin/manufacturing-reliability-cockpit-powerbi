	/// Voltage deviation from the machine's prior 30-day reference, in standard deviations.
	column 'Voltage Z'
		dataType: decimal
		isHidden
		formatString: 0.00
		lineageTag: d978236b-e2af-4e6c-81f0-b4a88298c62f
