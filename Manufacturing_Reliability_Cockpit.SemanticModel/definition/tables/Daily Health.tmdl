		isHidden
		formatString: 0
		lineageTag: 1c907086-4fe7-4b9b-83ee-568d33c64449
		summarizeBy: none
		sourceColumn: Maintenance Points

	/// Rule-based priority score 0-100 = sum of the four point columns; not a probability.
	column 'Recorded Priority Score'
