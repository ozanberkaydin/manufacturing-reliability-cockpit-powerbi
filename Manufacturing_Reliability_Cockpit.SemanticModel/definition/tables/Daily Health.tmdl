		summarizeBy: none
		sourceColumn: As Of Timestamp

	/// Share of expected hourly readings present for the date.
	column 'Telemetry Completeness'
		dataType: decimal
		isHidden
		formatString: 0.00
		lineageTag: f11074f8-40d2-4da9-ae9b-8409a54a6f84
