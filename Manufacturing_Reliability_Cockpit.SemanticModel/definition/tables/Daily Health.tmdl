		isHidden
		formatString: 0.00
		lineageTag: 549b3b51-9610-4343-88d8-198831fcd83d
		summarizeBy: none
		sourceColumn: Oldest Component Days

	/// Largest absolute sensor Z deviation on this date.
	column 'Sensor Deviation Max'
