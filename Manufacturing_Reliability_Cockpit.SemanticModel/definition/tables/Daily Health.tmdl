		sourceColumn: Telemetry Completeness

	partition 'Daily Health' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "/daily_health.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Machine ID", Int64.Type}, {"Date", type datetime}, {"Voltage", type number}, {"Rotation", type number}, {"Pressure", type number}, {"Vibration", type number}, {"Reading Count", Int64.Type}, {"Latest Timestamp", type datetime}, {"Voltage Z", type number}, {"Rotation Z", type number}, {"Pressure Z", type number}, {"Vibration Z", type number}, {"Failures 14 Days", Int64.Type}, {"Errors 7 Days", Int64.Type}, {"comp1 Days Since Replacement", type number}, {"comp2 Days Since Replacement", type number}, {"comp3 Days Since Replacement", type number}, {"comp4 Days Since Replacement", type number}, {"Components With History", Int64.Type}, {"Oldest Component Days", type number}, {"Sensor Deviation Max", type number}, {"Baseline Sensors", Int64.Type}, {"Failure Points", Int64.Type}, {"Error Points", Int64.Type}, {"Sensor Points", type number}, {"Maintenance Points", Int64.Type}, {"Priority Score", type number}, {"Priority Band", type text}, {"Priority Reasons", type text}, {"Suggested Inspection", type text}, {"As Of Timestamp", type datetime}, {"Telemetry Completeness", type number}}, "en-US")
				in
				    Typed

