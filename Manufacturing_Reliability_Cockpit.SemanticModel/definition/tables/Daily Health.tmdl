/// One row per machine, date with end-of-day score and daily telemetry summary. Only past/current records contribute.
table 'Daily Health'
	lineageTag: 3d138741-608e-462c-af7e-0f32a9cfa083

	/// One timestamped hourly sample is one observed telemetry hour; not proof of productive uptime.
	measure 'Observed Telemetry Hours' = SUM('Daily Health'[Reading Count])
		formatString: #,##0
		displayFolder: Reliability
		lineageTag: 32c7c853-11a5-4dbe-bfb9-cbe8df910488

	/// Distinct machines with telemetry in selected period.
	measure 'Observed Machines' = DISTINCTCOUNT('Daily Health'[Machine ID])
		formatString: #,##0
		displayFolder: Reliability
		lineageTag: 9d4e0a45-b345-4c9d-89e4-f06d85f0fb44

	/// Latest available daily snapshot no later than maximum selected date; historical end-of-day convention.
	measure 'As Of Date' =
			VAR _selected = MAX('Dates'[Date])
			VAR _last = CALCULATE(MAX('Daily Health'[Date]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] <= _selected)
			RETURN _last
		formatString: yyyy-MM-dd
		displayFolder: Priority
		lineageTag: e35a8dfe-3910-481e-98bf-661396cf934a

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Priority Score' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Recorded Priority Score]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0.0
		displayFolder: Priority
		lineageTag: 42859efd-b6ae-4926-8144-941f41dbffa6

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Recent Failures 14 Days' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Failures 14 Days]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0
		displayFolder: Priority
		lineageTag: 07f3dddb-56f2-4fe8-b45f-ebe4f878e745

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Recent Errors 7 Days' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Errors 7 Days]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0
		displayFolder: Priority
		lineageTag: b63e8b4f-c527-4be8-9923-7884d49d3063

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Maximum Sensor Deviation' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Sensor Deviation Max]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0.00
		displayFolder: Priority
		lineageTag: 03e54684-3e72-4ea3-afb4-05f9c08a053f

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Oldest Component Replacement Days' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Oldest Component Days]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0
		displayFolder: Priority
		lineageTag: 728ee20a-f827-4619-83ae-b9860ef8d0e8

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Failure Score Points' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Failure Points]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0
		displayFolder: Priority
		lineageTag: a3093fcb-bc37-4d5e-846a-d4f691474c2b

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Error Score Points' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Error Points]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0
		displayFolder: Priority
		lineageTag: b43808ee-8062-4622-ad43-99b60d7d7082

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Sensor Score Points' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Sensor Points]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0.0
		displayFolder: Priority
		lineageTag: 6b67434b-c5fa-4342-b6dc-a947fb312f82

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Maintenance Score Points' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Maintenance Points]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0
		displayFolder: Priority
		lineageTag: 7e7b51c3-1aaa-4e8b-a978-330c52aeccce

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Baseline Sensor Count' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Baseline Sensors]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0
		displayFolder: Priority
		lineageTag: a0f54ab9-bbfa-4b52-b06f-fec42d11eddf

	/// Latest selected as-of snapshot. For scores and reasons select an individual machine or use the ranking table.
	measure 'Component History Count' =
			VAR _asOf = [As Of Date]
			RETURN IF(NOT ISBLANK(_asOf), CALCULATE(MAX('Daily Health'[Components With History]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf))
		formatString: 0
		displayFolder: Priority
		lineageTag: f502794a-90ee-4919-8d85-32f976d668da

	/// Rule-based prioritization, not probability; analytical recommendations requiring engineering review.
	measure 'Priority Reasons' =
			VAR _asOf = [As Of Date]
			RETURN IF(HASONEVALUE('Machines'[Machine ID]), CALCULATE(SELECTEDVALUE('Daily Health'[Recorded Priority Reasons]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf), "Select one machine")
		formatString: General
		displayFolder: Priority
		lineageTag: de68337c-004e-4b04-87a4-c4a4046c06e4

	/// Rule-based prioritization, not probability; analytical recommendations requiring engineering review.
	measure 'Suggested Inspection' =
			VAR _asOf = [As Of Date]
			RETURN IF(HASONEVALUE('Machines'[Machine ID]), CALCULATE(SELECTEDVALUE('Daily Health'[Recorded Suggested Inspection]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf), "Select one machine")
		formatString: General
		displayFolder: Priority
		lineageTag: 819923a8-b945-4751-82fa-bdf8e9e9b6f1

	/// Rule-based prioritization, not probability; analytical recommendations requiring engineering review.
	measure 'Priority Status' =
			VAR _asOf = [As Of Date]
			RETURN IF(HASONEVALUE('Machines'[Machine ID]), CALCULATE(SELECTEDVALUE('Daily Health'[Priority Band]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf), "Select one machine")
		formatString: General
		displayFolder: Priority
		lineageTag: 1f81e546-48da-4ba7-ade4-7b19fc645482

	/// Dense rank within model/machine selection at the selected end date.
	measure 'Priority Rank' = IF(HASONEVALUE('Machines'[Machine ID]), RANKX(ALLSELECTED('Machines'), [Priority Score], , DESC, Dense))
		formatString: 0
		displayFolder: Priority
		lineageTag: 2209fba1-432a-41ef-9ce6-02a98529ad00

	/// Count of machines at rule-based score >=60 as of selected date.
	measure 'High Priority Machines' = SUMX(VALUES('Machines'[Machine ID]), IF([Priority Score] >= 60, 1, 0))
		formatString: 0
		displayFolder: Priority
		lineageTag: bb3e41d5-bf4b-4e24-8c27-488e43fe63a5

	/// Count at 30<=score<60 as of selected date.
	measure 'Watch Priority Machines' = SUMX(VALUES('Machines'[Machine ID]), IF([Priority Score] >= 30 && [Priority Score] < 60, 1, 0))
		formatString: 0
		displayFolder: Priority
		lineageTag: df50e03c-dbb4-4f6a-a50d-e1e84a5b7300

	/// Latest telemetry actually observed at selected snapshot. No live feed.
	measure 'Latest Observed Timestamp' =
			VAR _asOf = [As Of Date]
			RETURN CALCULATE(MAX('Daily Health'[Latest Timestamp]), REMOVEFILTERS('Dates'), 'Daily Health'[Date] = _asOf)
		formatString: yyyy-MM-dd HH:mm
		displayFolder: Context
		lineageTag: 4545cebe-d2ed-4c5d-88ca-672eda80d15a

	/// Historical cutoff and meaning of the priority score.
	measure 'Priority Date Label' = "As of " & FORMAT([As Of Date], "dd MMM yyyy") & " | rule-based score, not ML probability"
		formatString: General
		displayFolder: Context
		lineageTag: 1afc605a-4f6a-426e-92c7-f780a9e71020

	/// One row per machine, date with end-of-day score and daily telemetry summary. Only past/current records contribute.
	column 'Machine ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0020bcd6-581a-4cc3-94bb-2933f837e9cf
		summarizeBy: none
		sourceColumn: Machine ID

	/// One row per machine, date with end-of-day score and daily telemetry summary. Only past/current records contribute.
	column Date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 83b27a4b-ed4b-4609-8a51-853eb67fe245
		summarizeBy: none
		sourceColumn: Date

	/// Daily mean voltage reading (source units).
	column Voltage
		dataType: decimal
		isHidden
		formatString: 0.00
		lineageTag: 7c8df76a-1c74-49b9-bfd5-267d70902a1c
