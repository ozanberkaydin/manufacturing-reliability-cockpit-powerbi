{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "machine_health",
  "displayName": "Machine Health",
  "displayOption": "FitToPage",
  "height": 1080,
  "width": 1920,
  "filterConfig": {
    "filters": [
      {
        "name": "MachineDrillFilter",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Machines"
              }
            },
            "Property": "Machine"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      }
    ]
  },
  "pageBinding": {
    "name": "Pod",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "MachineDrillParameter",
        "boundFilter": "MachineDrillFilter",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Machines"
              }
            },
            "Property": "Machine"
          }
        }
      }
    ]
  },
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F3F6F8'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  }
}
